# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>

# research database (Emotion_Data) — raw multimodal features only
EMOTION_MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# Shared key droids send as the X-Droid-Key header to POST /api/emotion/segments
# Leave unset only for local testing — the route is unauthenticated without it
DROID_API_KEY=

# Seeded admin account (used by scripts/seed.js or similar)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin

# JWT secret — generate with: openssl rand -base64 64
JWT_SECRET=your-long-random-secret-here

# Port the API listens on
PORT=5000

# Comma-separated origins allowed for CORS
# Local dev:   http://localhost:3000
# Production:  https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
