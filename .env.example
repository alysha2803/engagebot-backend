# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>

# Zhang's cluster — EngageBot writes to its own database there (same format as Emotion_Data)
EMOTION_MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
# Optional, defaults to EngageBot_Emotion (name is case-sensitive)
EMOTION_DB_NAME=EngageBot_Emotion

# Shared key droids send as the X-Droid-Key header (uploads, heartbeat, reports, check-in)
# Generate with: openssl rand -hex 32
# Leave unset only for local testing — droid-only routes are unauthenticated without it
# (always rejected when NODE_ENV=production)
DROID_API_KEY=

# Seeded admin account (used by scripts/seed.js or similar)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin
# School the admin (and every teacher they register) belongs to
ADMIN_SCHOOL=SMK Example

# JWT secret — generate with: openssl rand -base64 64
JWT_SECRET=your-long-random-secret-here

# Optional: DNS used for mongodb+srv lookups. Defaults to Google DNS.
# Use "system" for the machine's resolver, or list servers: 1.1.1.1,1.0.0.1
# DNS_SERVERS=system

# Optional: set to 1 when deployed behind a hosting proxy (Render, Railway...)
# TRUST_PROXY=1

# Port the API listens on
PORT=5000

# Comma-separated origins allowed for CORS
# Local dev:   http://localhost:3000
# Production:  https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
